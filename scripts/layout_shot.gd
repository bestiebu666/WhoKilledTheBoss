extends Node
## 布置核对图：新收的 13 件资产摆好之后，从几个真实玩家视角各拍一张，
## 用来肉眼检查「有没有穿模、朝向对不对、大小合不合适」。
## 和 shot.gd 一样只截当前视口，不加 --headless。
##
##   Godot_v4.7.2-stable_win64_console.exe --path . res://scenes/layoutshot.tscn

const OUT_DIR := "res://shots/"

var main: Node3D


func _ready() -> void:
	DirAccess.make_dir_recursive_absolute(OUT_DIR)
	var packed: PackedScene = load("res://scenes/main.tscn")
	main = packed.instantiate()
	add_child(main)
	await _settle(40)
	# 核对图是看「东西摆在哪」的，人身上那朵思考框会挡视线 —— 摘掉。
	# （思考框本身看 shots/diag/，那是真玩家视角。）
	for nid in main._npc_bubbles:
		var bb: Node3D = main._npc_bubbles[nid]
		if bb != null:
			bb.visible = false

	# 展架 1.95 米（小人的 1.5 倍）。机位一律按**目标物半高**估：
	# 俯角 = atan((相机高 3.0 − 半高) / 水平距离)。拍 1.95 米的展架就是 atan(2.0 / d)。
	# 四个展架现在的位置是照作者在俯视图上手写的 1/2/3/4 复现的，中心约 (1.78, -3.88)。
	await _pose(Vector3(1.78, 0, 1.6), 0.0, -20.0)
	await _shot("L1_四个展架散在那块空地上")

	# 4 个展架是散开的，从东边回看整块空地 —— 站成一排还是散着，这个角度最看得出来。
	await _pose(Vector3(6.0, 0, -2.0), 65.0, -28.0)
	await _shot("L2_从东侧回看散布的展架")

	# 小人长到 1.30 米之后原来的机位贴到脸上了（只剩一个头顶）—— 往后拉开。
	await _pose(Vector3(-0.5, 0, -0.3), 12.0, -32.0)
	await _shot("L3_外聘设计总监")

	# 原来俯角只有 14°、离人 2.4 米 —— 两个人只在画面最下面露个头。拉开并加大俯角。
	await _pose(Vector3(-4.0, 0, 2.6), 0.0, -34.0)
	await _shot("L4_凤凰男与实习1号")

	await _pose(Vector3(2.6, 0, 2.4), -120.0, -29.0)
	await _shot("L5_东南角休息区")

	await _pose(Vector3(4.6, 0, 2.2), -138.0, -38.0)
	await _shot("L6_沙发近景")

	await _pose(Vector3(-7.0, 0, -1.5), 14.0, -42.0)
	await _shot("L7_门边发财树2")

	# 前台那张褐色桌子按作者要求撤了，位置让给雕塑（就落在作者在俯视图上圈的 ⑤ 上）。
	await _pose(Vector3(4.0, 0, -2.0), -48.0, -20.0)
	await _shot("L8_雕塑与发财树1")

	# 雕塑 3.25 米 = 2.5 个小人高。退到 4 米外才装得下
	# （3.25 米 < 4.0 × 2 × tan27.5° = 4.17 米）。`rot 102` = 转开沙发、正面朝着西墙那扇门。
	await _pose(Vector3(6.15, 0, -0.4), 0.0, -19.0)
	await _shot("L9_雕塑近景")

	# 雕塑（东侧北端）和沙发（东南角）隔着大半间房 —— 这一张把两头同框，
	# 站在房间中间往东看：左手边（南）是沙发，右手边（北）是雕塑。
	await _pose(Vector3(1.0, 0, -0.2), -90.0, -15.0)
	await _shot("L10_沙发与雕塑同框")

	# 北墙落地窗（2026-10-06 换上的真模型；作者随后要求「素材复用拼接把整面墙铺满」）：
	# 现在是 2 扇 7.78 米并排 = 15.56 米，要退到房间最南边才装得下整面墙
	# （水平半角 42.8°，8 / tan42.8° = 8.6 米；相机在 z = 5.0，离窗 10.8 米）。
	# 俯角按窗半高 2.25 米估：atan((3.0 − 2.25) / 10.8) ≈ 4°，留点余量给地面 → -10°。
	await _pose(Vector3(0.0, 0, 5.0), 0.0, -10.0)
	await _shot("L11_北墙整面落地窗")

	# 西墙那组玻璃门。2026-10-06 作者连改两次：「拉高 80cm」→ 2.5 变 3.30 米；
	# 再「不要只拉长，还应该拉宽一点，拉宽 80cm 左右」→ 4.63 变 **5.427 米**。
	# 门变宽之后原来那个 3.98 米的机位装不下了，退到 4.6 米外：
	# 门的半宽 2.71 米，水平半角 42.8° → 只要 2.93 米就塞得下；真正卡的是高度，
	# 竖直半角 27.5°，4.6 米处可见半高 2.40 米，门心 1.65 米 → 覆盖 [−0.75, 4.05]，够了。
	# 俯角 = atan((3.0 − 1.65) / 4.6) ≈ 16°。门心 z 已随加宽北移到 −1.9（让开人事资料柜）。
	await _pose(Vector3(-3.28, 0, -1.9), 90.0, -16.0)
	await _shot("L12_西墙玻璃门")

	# 沙发底下那张圆形地毯（2026-10-06 作者给的）。从房间中部朝东南看，
	# 让画面中心正好落在地毯圆心 (5.60, 3.60)：水平距离 √(5.6² + 4.6²) = 7.25 米，
	# 俯角 atan(3.0 / 7.25) ≈ 22.5°，朝东南 yaw ≈ -129°。
	# 地毯 4.8 米宽，在 7.25 米外只占画面约 1/3 —— 够看清「它比沙发大一圈」。
	await _pose(Vector3(0.0, 0, -1.0), -129.0, -22.0)
	await _shot("L13_沙发与圆形地毯")

	# 地面（2026-10-06 换的随机格子砖，一格 50 厘米）。刻意压到很大的俯角、朝东北看，
	# 让画面里同时有近处和远处的地面 —— 「格子有没有糊」只有在远处才能看出来，
	# 「四张图随机拼起来会不会看出接缝」也只有在同一张图里跨几块才看得出来。
	await _pose(Vector3(-4.5, 0, 3.0), 62.0, -48.0)
	await _shot("L14_地面格子砖")

	# 2026-10-06 作者换的**三人办公桌**（SM_F_Desk3P），替换掉老的 SM_F_DeskBench；
	# 2026-10-05 又换成作者最新一版（深蓝隔板 + 粉抽屉柜、149 万面），**尺寸位置逐位未变**。
	# 站在工位岛正南往北看：两排背靠背、隔板对隔板。岛心 x=-4.0、z=-4.27。
	# 相机到岛心 3.67 米，俯角按桌子半高 0.485 米算：atan((3.0 − 0.485) / 3.67) ≈ 34°。
	# 门也在这张里露一角（西墙 x=-7.88），能顺带看出「门现在比桌子高得多了」。
	await _pose(Vector3(-4.0, 0, -0.6), 0.0, -34.0)
	await _shot("L15_三人办公桌岛")

	# 2026-10-06 作者删掉整个会议区（会议桌 + 6 把椅子），换成新给的**吧台**
	# （SM_F_Bar，摆在标注 ⑥ 那个点上 (5.40, 0.30)，就在沙发正北 1.8 米）。
	# 这一张要一张里同时看到「吧台 + 沙发」：站在沙发西南、朝东北看，
	# 目标取两者的中间 (5.8, 2.4)，相机到它 5.8 米，俯角 atan((3.0 − 0.5) / 5.8) ≈ 23°。
	# ⚠ 视线要擦过沙发西沿（x = 4.79）—— 相机放在 (2.6, 4.8)，到 z=2.1 时 x=4.28，让得开。
	await _pose(Vector3(2.6, 0, 4.8), -32.0, -23.0)
	await _shot("L16_吧台与沙发同框")

	# 吧台近景：从西南斜看，正对着它的**柜门那一面**（room.json 里 rot 180 = 柜门朝南）。
	# 相机 (3.6, 3.6) 到吧台心 3.76 米，俯角 atan((3.0 − 0.45) / 3.76) ≈ 34°。
	# 台面上的水壶 / 马克杯 / 咖啡机 / 绿植在这个距离能看清。
	await _pose(Vector3(3.6, 0, 3.6), -29.0, -34.0)
	await _shot("L17_吧台近景")

	# 2026-10-05 晚些：作者做了一张**新的会议桌**（椭圆长桌 + 8 把椅子），
	# 标在俯视图那块预留区里（反算 → 桌心 (−2.41, 2.41)、长轴沿 z）。
	# ⚠ 第二版按作者要求「和岛台一样大」放大到 **2.85 × 1.123 × 4.80 米**（长轴 4.8 = 岛台长度），
	# 桌子长了 3 倍，相机必须往后退。
	# L18 全貌：站在它北边朝南看，相机 (−2.4, 0, −2.6) 到桌心 (2.41) 有 5.0 米，
	# 桌子半长 2.4 → 俯角 atan((3.0 − 0.56) / 5.0) ≈ 26°，一屏装得下整张桌子。
	await _pose(Vector3(-2.4, 0, -2.6), 180.0, -26.0)
	await _shot("L18_会议桌全貌")

	# L19 近景：从东侧斜看，能看清台面上的粉色桌旗 + 小立牌、以及两侧的椅子。
	# ⚠ camera yaw 0 = 朝北（-z），yaw +90 = 朝西（-x）。桌子在相机西边，所以要 +90。
	# 相机 (1.6, 2.4) 到桌心 4.0 米，俯角 atan((3.0 − 0.56) / 4.0) ≈ 31°。
	await _pose(Vector3(1.6, 0, 2.4), 90.0, -31.0)
	await _shot("L19_会议桌近景")

	# 2026-10-05 稍后：作者给了**三把办公转椅**，按他画的 5 个圈随机摆到 6 个工位上
	# （3 列 × 南北 2 排，列 x = −5.287 / −4.000 / −2.713），其中南排 3 那把「散漫」地
	# 斜摆在桌岛东南角外（作者圈 ⑤）。
	# L20 要一张看全 6 把椅子 + 工位岛：站在桌岛**东南**朝西北看。
	# camera yaw 0 = 朝北（-z），+90 = 朝西（-x）；朝西北 ≈ 44°。
	await _pose(Vector3(-1.2, 0, -1.4), 44.0, -32.0)
	await _shot("L20_工位椅六把")

	# L21 从西南侧再拍一张，能看清「北排椅子贴着北窗、南排椅子贴着桌」的层次。
	# 相机 (−7.0, −1.0) 到桌心 (−4.0, −4.3)：朝东北 ≈ −42°。
	await _pose(Vector3(-7.0, 0, -1.0), -42.0, -28.0)
	await _shot("L21_工位椅另一侧")

	# L22 正上方正交俯视工位岛 —— 唯一能一眼看出「两排背靠背、各自面朝自己的桌子」
	# 的角度（椅背是窄条、坐面是宽块）。相机挂在 (−4.0, 12, −3.9) 直下看。
	await _ortho_top(Vector3(-4.0, 12.0, -3.9), 4.6)
	await _shot("L22_工位岛正上方")
	# 拍完把天花板和玩家相机还回来，否则 L23 是空的。
	for ch in main.get_children():
		var n := String(ch.name)
		if n == "SM_B_Ceiling" or n.begins_with("SM_B_Lamp"):
			(ch as Node3D).visible = true
	var otc := main.get_node_or_null("OrthoTopCam")
	if otc != null:
		(otc as Camera3D).current = false
		otc.queue_free()
	var pc2 := main.get_viewport().get_camera_3d()
	if pc2 != null:
		pc2.current = true

	# L23 从西侧平视（朝东），北在画面左 —— 能看清每把椅子的坐面朝哪张桌子。
	# ⚠ 玩家相机平时吊在 3 米高（`eye_height`），俯拍整间房用；要平视椅子就得把
	# 它临时压到 1.15 米（椅子中段），拍完再还回去。
	main.eye_height = 1.15
	await _pose(Vector3(-6.9, 0, -4.25), -90.0, 2.0)
	await _shot("L23_工位椅侧平视")
	main.eye_height = 3.0

	# L30/L31 感叹号线索提示（2026-10-05 晚）：作者不要发光定位了，改成头顶一个
	# 手绘感叹号。要核对两件事 —— ① 俯视时是不是正 facing 相机（billboard 生效）；
	# ② 大小是不是「比人头略小一圈」（CLUE_ICON_H = 0.38 米 vs 小人 1.30 米）。
	# ⚠ 0.62 → 0.44（2026-10-05 晚）→ 0.38（2026-10-06），作者两次说「再小一点」。
	# ⭐ 2026-10-06 夜：作者「办公室一共有 6 张桌子」→ 南排补了 2 个探索点
	#    （`leader_desk` 南排西格 / `boss_desk` 南排东格），工位区的感叹号
	#    从 **3 个变 5 个**（南排中间那格是空位，没点）。
	# L30 看工位区五个探索点（桌面上，矮 —— 最考验 lift 会不会贴脸）：
	#     ⚠ 机位比原来( z=-0.8 )再退 0.4 米，否则南排那两个（更近、俯角更大）会被切在画框下边。
	#     桌面点圆心 y ≈ 0.6 + LIFT 0.42 + H/2 0.19 = 1.21；眼高 3.0。
	#     到南排(z=-3.33) 2.93 米 → 31.4°；到北排(z=-4.30) 3.90 米 → 24.6°。
	await _pose(Vector3(-4.0, 0, -0.4), 0.0, -30.0)
	await _shot("L30_感叹号_工位五张桌")

	# L43 背靠背两组桌子 + 5 个感叹号的**斜角**（一眼看出两组桌子是背靠背、且 5 个点各自
	#    落在哪一格的桌面上）。相机放工位岛东南，朝西北看（yaw 0=北 / +90=西 → 朝西北 ≈ 40°）。
	await _pose(Vector3(-1.0, 0, -0.9), 40.0, -34.0)
	await _shot("L43_感叹号_工位岛斜角")
	# L31 看吧台探索点（台面 1.28 米，最高的一个）：从西南斜看。
	await _pose(Vector3(3.2, 0, 3.2), -32.0, -22.0)
	await _shot("L31_感叹号_吧台")
	# L32 人事资料柜（贴西墙）—— 看感叹号会不会插进墙里。
	# ⛔ 相机得**真的冲着那个高度**：柜子探索点 pos.y=0、lift 0.42 → 图标中心 y≈0.61，
	#    眼睛在 3.0 米高、水平距 2.35 米，需要的俯角是 atan(2.39/2.35)≈45°。
	#    原来写 -14°（等于对着墙上 2.4 米处）—— 框里只有一片空墙，什么也验不到。
	# ⭐ 2026-10-06 柜子换成作者给的真模型（双门柜、`rot -90` 门朝屋内、柜背贴墙 x=−8.0）；
	#    **同一天晚上作者说「太小了」，等比放大 1.3 倍** → 现在 1.1327 × 1.768 × 0.5715 米
	#    （`pos.x` 跟着挪到 −7.7143 保持贴墙）。这一张要同时能看出
	#    「双开门是不是朝屋里」「柜背是不是贴住墙」「放大之后有没有长进隔壁」。
	await _pose(Vector3(-5.2, 0, 2.0), 90.0, -45.0)
	await _shot("L32_感叹号_人事柜")
	# L35 人事柜·斜角 —— billboard 是绕 Y 轴转的，斜着看才最容易插进柜子里；
	#     顺带一眼看出双开门朝向（门把手指向屋里才对）。
	# ⛔ 俯角按目标高度反算：眼高 3.0、水平距 √(3.18²+1.6²)=3.56、目标 y≈0.61
	#    → atan((3.0−0.61)/3.56) ≈ 34°。（第一版给 −22°，图标被切在画框底下。）
	await _pose(Vector3(-4.6, 0, 0.4), 117.0, -34.0)
	await _shot("L35_人事柜_斜角")

	# L36 小人身上的感叹号（2026-10-06 作者：「小人也是可探索点」）——
	#    站南边朝北看凤凰男 + 实习 1 号（两个都站在自己工位前面）。
	# ⛔ 和小人**身体**的位置规则同一条：`_clue_icon_at()` 看见竖直方向重叠就把图标
	#    往水平方向推出去 —— 所以它落在人**身侧约 0.61 米高**的地方，
	#    和桌面那批感叹号同一个高度，不是飘在头顶（头顶有思考框 `_bubble`，会叠在一起）。
	# ⭐ 另外两个小人不用单独拍：老板在 `L6_沙发近景` 里、总监在 `L3_外聘设计总监` 里，
	#    这两张现在都能看到他身上那根感叹号。
	await _pose(Vector3(-4.0, 0, 1.5), 0.0, -34.0)
	await _shot("L36_感叹号_小人_凤凰男与实习1号")

	# L33/L34 公示板（西墙南段, pos=[-7.94,1.35,4.4]，正面朝 +x）。
	# ⛔ 2026-10-06 作者截图「穿模」就在这一根：`pos.y=1.35` 是板的**下沿**不是面，
	#    感叹号圆心原来正好落在板子里。拍两张 —— 正面一张、斜角一张，
	#    因为 billboard 是**绕 Y 轴转**的，斜角才是最容易插进板子的视角。
	await _pose(Vector3(-5.5, 0, 4.4), 90.0, -28.0)
	await _shot("L33_感叹号_公示板_正面")
	await _pose(Vector3(-6.2, 0, 2.6), 136.0, -23.0)
	await _shot("L34_感叹号_公示板_斜角")

	# ---- 2026-10-06 作者：「场景里的家具全部可探索」→ 给可探索家具补感叹号核对图 ----
	# ⚠⚠ 2026-10-06 夜更正：**这些家具身上现在没有感叹号**，而且是对的。
	#    作者填的文案表里，这 8 个点位（人台 2·3·4 / 会议桌 / 发财树 1·2 / 雕塑 / 沙发）
	#    **三轮都没写过任何文字** → 按「文字列全空 = 这一轮不要这个位置」的规则，
	#    它们头上不该有感叹号（`_ready()` 里那次 `_refresh_clue_icons()` 会把它们收掉）。
	#    ⭐ 所以 L38 / L40 / L41 / L42 这几张现在的意义变成了「**核对它们确实没有感叹号**」。
	#    （人台 1 号 `mannequin_01` 例外：作者第 1 轮给了文案，所以它亮着，见 L38。）
	#    哪天真给它们补了文案，这几张会立刻重新长出感叹号 —— 不用改代码。
	# 人台（4 个，陈列角空地）—— 复用 L1 机位。
	await _pose(Vector3(1.78, 0, 1.6), 0.0, -20.0)
	await _shot("L38_感叹号_人台四个")
	# 饮水机（东南角，老板休息区）—— 站房间偏西南朝东南看，正对饮水机。
	# ⚠ 2026-10-06 晚：南墙白板删了，这张不再「同框」，改成只框饮水机（原来那张机位朝北、
	#   白板根本没进画面，「与白板」这个后缀名不副实）。
	await _pose(Vector3(1.8, 0, 4.4), -115.0, -34.0)
	await _shot("L39_感叹号_饮水机")
	# 雕塑 + 发财树 1（东北角）—— 复用 L8 机位。（雕塑自己的感叹号：第 1 轮没有，见上）
	await _pose(Vector3(4.0, 0, -2.0), -48.0, -20.0)
	await _shot("L40_感叹号_雕塑与发财树1")
	# 会议桌（中间偏西）—— 复用 L19 斜角机位，一眼看出桌旗 + 感叹号（第 1 轮没有）。
	await _pose(Vector3(1.6, 0, 2.4), 90.0, -31.0)
	await _shot("L41_感叹号_会议桌")
	# 沙发（东南角，老板/部长坐这）—— 复用 L6 机位。
	# ⭐ 沙发自己第 1 轮没有感叹号；画框里那根是**站在沙发前地毯上的部长（`boss`）**身上的
	#    —— 作者 2026-10-06 夜澄清「部长＝老板＝在沙发角落的人」。这张正好用来核对「人身上的
	#    那根在胸口高度、贴着人不浮空」，以及「沙发本身不再多出一根」。
	await _pose(Vector3(4.6, 0, 2.2), -138.0, -38.0)
	await _shot("L42_感叹号_沙发")

	print("[layout] 核对图完成，见 " + OUT_DIR)
	Audio.shutdown()   # 放掉 BGM 资源，退出日志才干净
	get_tree().quit(0)


func _pose(pos: Vector3, yaw: float, pitch: float) -> void:
	main.player.global_position = pos
	main.yaw = yaw
	main.pitch = pitch
	main._sync_camera()
	await _settle(5)


## 临时正交俯视相机（挂在玩家相机之外），用于 L22。拍完就把玩家相机切回来。
## 天花板 + 6 盏吊灯扣在头顶，不摘掉俯视什么都看不见（和 topview.gd 同一个坑）。
func _ortho_top(eye: Vector3, size: float) -> void:
	for ch in main.get_children():
		var n := String(ch.name)
		if n == "SM_B_Ceiling" or n.begins_with("SM_B_Lamp"):
			(ch as Node3D).visible = false
	var pc := main.get_viewport().get_camera_3d()
	if pc != null:
		pc.current = false
	var c := Camera3D.new()
	c.name = "OrthoTopCam"
	c.projection = Camera3D.PROJECTION_ORTHOGONAL
	c.size = size
	main.add_child(c)
	c.global_position = eye
	c.rotation_degrees = Vector3(-90.0, 0.0, 0.0)
	c.current = true
	await _settle(6)


func _settle(frames: int) -> void:
	for i in range(frames):
		await get_tree().process_frame


func _shot(name: String) -> void:
	await RenderingServer.frame_post_draw
	var img := get_viewport().get_texture().get_image()
	var path := OUT_DIR + name + ".png"
	var err := img.save_png(path)
	print("[layout] %s -> %s" % [path, "ok" if err == OK else "ERR %d" % err])
